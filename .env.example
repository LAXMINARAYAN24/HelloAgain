HOST=127.0.0.1
PORT=4310
APP_ORIGIN=http://localhost:4310
NODE_ENV=development
# Sample accounts exist only with local SQLite in development.
DEMO_MODE=false
SQLITE_PATH=./data/helloagain.sqlite
# Local video: run Setup-Video.cmd once. Camera screening then starts automatically.
VIDEO_ENABLED=true
# Optional absolute path to a Python executable with requirements-video.txt installed:
# VIDEO_PYTHON=C:/path/to/python.exe
EMAIL_MODE=local
# Local reset emails are written here; never served by the website.
MAIL_DIRECTORY=./data/mail
# Production requires an email provider (no messages are sent during this setup).
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=HelloAgain <support@your-domain.example>
# Optional, later: server-only Postgres/Supabase connection string.
# DATABASE_URL=postgresql://...
# PG_CA_CERT_PATH=./certs/database-ca.crt
# For production: NODE_ENV=production, DEMO_MODE=false, APP_ORIGIN=https://your-domain
# Production requires PostgreSQL, HTTPS, SMTP, and completed launch review.
